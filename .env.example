# No environment variables are required for the homepage preview.
# Future VITE_ variables are public browser configuration, never secrets.
# Configure the API environment separately when the backend is implemented.

# Optional canonical URL. Configure the owner-approved production URL before launch.
VITE_PUBLIC_SITE_URL=https://rakesh-1143.github.io/vape-hub/
# Keep the development/client preview out of search results. Set true only for launch.
VITE_INDEXABLE=false
# Optional absolute URL of an approved social preview image:
# VITE_OG_IMAGE_URL=https://approved-domain.example/social-preview.jpg
